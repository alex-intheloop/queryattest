QUERYATTEST_DATABASE_URL=postgresql://queryattest_reader:queryattest_reader@localhost:5432/queryattest
QUERYATTEST_POLICY_PATH=config/policy.yaml
QUERYATTEST_SEMANTICS_PATH=config/semantics.yaml
QUERYATTEST_STATE_PATH=.queryattest/state.db
# Generate with: queryattest generate-secret
QUERYATTEST_TICKET_SECRET=replace-with-at-least-32-random-bytes

# Immutable local identity for stdio. Remote HTTP deployments should replace this provider with OAuth/OIDC claims.
QUERYATTEST_USER_ID=alex
QUERYATTEST_ROLES=finance_analyst
QUERYATTEST_TENANT_ID=tenant-a
QUERYATTEST_TRANSPORT=stdio
QUERYATTEST_HOST=127.0.0.1
QUERYATTEST_PORT=8000
# Keep false outside the disposable Docker Compose demo. The environment
# principal provider is not a remote multi-user authentication boundary.
QUERYATTEST_ALLOW_INSECURE_REMOTE_HTTP=false
QUERYATTEST_DB_POOL_MIN_SIZE=1
QUERYATTEST_DB_POOL_MAX_SIZE=5
QUERYATTEST_APPLICATION_NAME=queryattest
QUERYATTEST_OTEL_ENABLED=false
